    "build": "tsc && node -e \"require('fs').cpSync('src/core/onnx','dist/core/onnx',{recursive:true,filter:(f)=>!/\\.(db|rvf|lock)$/.test(f)})\"",
    "verify-dist": "node scripts/verify-dist.js",
    "prepack": "npm run build && npm run verify-dist",
