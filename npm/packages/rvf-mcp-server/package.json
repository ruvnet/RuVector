{
  "name": "@ruvector/rvf-mcp-server",
  "version": "0.2.4",
  "description": "MCP server for local vector search over portable RVF files: Claude Code, Cursor and other MCP clients create, fill and query HNSW-indexed .rvf stores over stdio or SSE.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rvf-mcp-server": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "start:stdio": "node dist/cli.js --transport stdio",
    "start:sse": "node dist/cli.js --transport sse --port 3100",
    "dev": "tsc --watch",
    "test": "tsc && node --test --test-force-exit test/server.test.mjs test/sse.test.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "vector-search",
    "vector-database",
    "embeddings",
    "rag",
    "ai-agents",
    "claude-code",
    "typescript",
    "ruvector",
    "rvf"
  ],
  "license": "MIT",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/RuVector.git",
    "directory": "npm/packages/rvf-mcp-server"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/RuVector/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@ruvector/rvf": "^0.4.8",
    "express": "^4.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
