{
  "name": "ruvector-extensions",
  "version": "0.1.6",
  "description": "Advanced features for ruvector: embeddings, UI, exports, temporal tracking, and persistence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "README_UI.md",
    "PERSISTENCE.md",
    "EMBEDDINGS_QUICKSTART.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ui', 'dist/ui', { recursive: true })\"",
    "dev": "tsc --watch",
    "test": "node --test tests/*.test.js",
    "example:ui": "tsx src/examples/ui-example.ts"
  },
  "keywords": [
    "embeddings",
    "openai",
    "neo4j",
    "ruvector",
    "ruvnet",
    "vector-database",
    "vector-search",
    "hnsw",
    "rag",
    "semantic-search",
    "knowledge-graph",
    "gnn",
    "graph-embeddings",
    "link-prediction",
    "attention",
    "local-llm"
  ],
  "author": "ruv.io Team <info@ruv.io> (https://ruv.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvector.git",
    "directory": "npm/packages/ruvector-extensions"
  },
  "homepage": "https://ruv.io",
  "bugs": {
    "url": "https://github.com/ruvnet/ruvector/issues"
  },
  "dependencies": {
    "ruvector": "^0.3.14",
    "@anthropic-ai/sdk": "^0.24.0",
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "openai": "^4.0.0",
    "cohere-ai": "^7.0.0",
    "@khive-ai/lattice-embed-wasm": "^0.6.1"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "@khive-ai/lattice-embed-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
