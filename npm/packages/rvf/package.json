{
  "name": "@ruvector/rvf",
  "version": "0.4.12",
  "description": "RuVector Format (RVF): TypeScript SDK for a portable single-file vector database with HNSW vector search, native and WASM backends.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "smoke": "node scripts/smoke-query-create.mjs",
    "smoke:idmap": "node scripts/smoke-idmap-durability.mjs",
    "smoke:cow": "node scripts/smoke-cow-durability.mjs",
    "smoke:batch-upsert": "node scripts/smoke-batch-upsert.mjs",
    "bench": "tsx bench/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rvf",
    "vector-database",
    "vector-search",
    "hnsw",
    "typescript",
    "wasm",
    "ruvector",
    "ruvnet",
    "copy-on-write",
    "napi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvector.git",
    "directory": "npm/packages/rvf"
  },
  "homepage": "https://ruv.io",
  "bugs": {
    "url": "https://github.com/ruvnet/ruvector/issues"
  },
  "dependencies": {
    "@ruvector/rvf-node": "^0.4.7"
  },
  "optionalDependencies": {
    "@ruvector/rvf-wasm": "^0.1.7",
    "@ruvector/rvf-solver": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
