{
  "name": "@ruvector/rvf",
  "version": "0.3.4",
  "description": "RuVector Format — unified TypeScript SDK for vector intelligence",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "smoke": "node scripts/smoke-query-create.mjs",
    "smoke:idmap": "node scripts/smoke-idmap-durability.mjs",
    "smoke:cow": "node scripts/smoke-cow-durability.mjs",
    "bench": "tsx bench/index.ts",
    "typecheck": "tsc --noEmit",
    "test:readonly": "node --test tests/readonly.test.cjs"
  },
  "keywords": [
    "vector",
    "database",
    "binary-format",
    "hnsw",
    "simd",
    "rvf"
  ],
  "license": "MIT",
  "repository": "https://github.com/ruvnet/ruvector",
  "dependencies": {
    "@ruvector/rvf-node": "^0.2.3"
  },
  "optionalDependencies": {
    "@ruvector/rvf-wasm": "^0.1.7",
    "@ruvector/rvf-solver": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
