{
  "name": "@ruvector/graph-node",
  "version": "2.1.3",
  "description": "Native Node.js graph database bindings for RuVector: hypergraphs, Cypher queries, knowledge graph persistence, built in Rust.",
  "main": "index.js",
  "types": "index.d.ts",
  "author": "ruv.io Team <info@ruv.io> (https://ruv.io)",
  "homepage": "https://ruv.io",
  "repository": {
    "directory": "npm/packages/graph-node",
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvector.git"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruvector/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build:napi": "napi build --platform --release --cargo-cwd ../../../crates/ruvector-graph-node",
    "test": "node test.js",
    "benchmark": "node benchmark.js",
    "publish:platforms": "node scripts/publish-platforms.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "optionalDependencies": {
    "@ruvector/graph-node-linux-x64-gnu": "2.1.2",
    "@ruvector/graph-node-linux-arm64-gnu": "2.1.2",
    "@ruvector/graph-node-darwin-x64": "2.1.2",
    "@ruvector/graph-node-darwin-arm64": "2.1.2",
    "@ruvector/graph-node-win32-x64-msvc": "2.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "graph-database",
    "knowledge-graph",
    "napi",
    "rust",
    "rag",
    "ruvector",
    "ruvnet",
    "graph",
    "neo4j",
    "vector-database",
    "ai",
    "machine-learning",
    "nodejs",
    "wasm"
  ]
}
