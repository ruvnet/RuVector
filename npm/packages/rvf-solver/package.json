{
  "name": "@ruvector/rvf-solver",
  "version": "0.1.10",
  "description": "RVF self-learning temporal solver — Thompson Sampling, PolicyKernel, ReasoningBank",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/", "pkg/", "package.json"],
  "scripts": {
    "build": "tsc",
    "test": "node test/solver.test.mjs",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path ../../../crates/rvf/rvf-solver-wasm/Cargo.toml && wasm-opt -Oz ../../../crates/rvf/target/wasm32-unknown-unknown/release/rvf_solver_wasm.wasm -o pkg/rvf_solver_bg.wasm"
  },
  "keywords": ["ruvector", "rvf", "solver", "wasm", "webassembly", "thompson-sampling", "multi-armed-bandit", "reasoning-bank", "self-learning", "witness-chain"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvector.git",
    "directory": "npm/packages/rvf-solver"
  },
  "homepage": "https://github.com/ruvnet/ruvector/tree/main/npm/packages/rvf-solver#readme",
  "bugs": {
    "url": "https://github.com/ruvnet/ruvector/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
