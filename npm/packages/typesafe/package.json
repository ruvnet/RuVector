{
  "name": "@ruvector/typesafe",
  "version": "0.2.1",
  "description": "Local typed decisions (choice / score / noul) over sentence embeddings — a ruvector-powered, self-optimizing alternative to typesafe.ai's System One API.",
  "homepage": "https://ruv.io",
  "license": "MIT",
  "repository": {
    "directory": "npm/packages/typesafe",
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvector.git"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruvector/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typesafe": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "index.js",
    "index.d.ts",
    "README.md",
    "docs/adr",
    "wasm",
    "native",
    "scripts/fetch-models.mjs",
    "models/manifest.json"
  ],
  "keywords": [
    "embeddings",
    "wasm",
    "napi",
    "ruvector",
    "ruvnet",
    "typesafe",
    "vector-database",
    "vector-search",
    "hnsw",
    "rag",
    "semantic-search",
    "knowledge-graph",
    "gnn",
    "graph-embeddings",
    "link-prediction",
    "attention"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:napi": "napi build --platform --release --cargo-cwd ../../../crates/ruvector-typesafe-ffi",
    "typecheck": "tsc --noEmit -p tsconfig.typetest.json",
    "test": "node --test test/*.test.mjs bench/test/*.test.mjs",
    "test:all": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.typetest.json && node --test test/*.test.mjs bench/test/*.test.mjs",
    "prepublishOnly": "tsc -p tsconfig.json",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "typescript": "^5.9.3"
  }
}
