{
  "name": "@ruvector/typesafe",
  "version": "0.1.0",
  "description": "Local typed decisions (choice / score / noul) over sentence embeddings — a ruvector-powered, self-optimizing alternative to typesafe.ai's System One API. Native (napi-rs) with a WASM fallback; no network, no per-token cost.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/ruvector.git",
    "directory": "npm/packages/typesafe"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typesafe": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "index.js",
    "index.d.ts",
    "README.md",
    "docs/adr",
    "wasm",
    "native",
    "scripts/fetch-models.mjs",
    "models/manifest.json"
  ],
  "keywords": [
    "typesafe",
    "decisions",
    "classification",
    "embeddings",
    "calibration",
    "confidence",
    "jev",
    "system-one",
    "ruvector",
    "choice",
    "noul",
    "local-first",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:napi": "napi build --platform --release --cargo-cwd ../../../crates/ruvector-typesafe-ffi",
    "typecheck": "tsc --noEmit -p tsconfig.typetest.json",
    "test": "node --test test/*.test.mjs bench/test/*.test.mjs",
    "test:all": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.typetest.json && node --test test/*.test.mjs bench/test/*.test.mjs",
    "prepublishOnly": "tsc -p tsconfig.json",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "typescript": "^5.9.3"
  }
}
