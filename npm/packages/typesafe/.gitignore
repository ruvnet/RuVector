# Model weights are fetched by scripts/fetch-models.mjs and verified against
# models/manifest.json (ADR-005). They are NOT committed; the manifest IS.
models/*/
!models/manifest.json

# Build artifacts: produced by scripts/build-native.sh and build-wasm.sh, and
# by CI for the per-platform packages. Never committed — but they MUST ship in
# the npm tarball, which is what .npmignore below guarantees: when .npmignore
# exists npm stops consulting .gitignore, so these directories survive packing.
native/
wasm/
