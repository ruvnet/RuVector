+impl Qwen35Model {
+    /// Per-layer state of the isolated CPU experiment. Counters are cumulative.
+    pub fn bench_cpu_cache(&self) -> Vec<serde_json::Value> {
+        self.weights.layers.iter().filter_map(|(_, layer)| {
+            let FeedForwardWeights::Moe(moe) = &layer.ffn else { return None };
+            Some(match &moe.experts.pager {
+                Some(guard) => { let p = guard.lock().unwrap(); serde_json::json!([p.slots(),p.hits,p.misses,p.evictions,p.bytes]) },
+                None => serde_json::json!([moe.experts.num_experts,0,0,0,0]),
+            })
+        }).collect()
+    }
+}
