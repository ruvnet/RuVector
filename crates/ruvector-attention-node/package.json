{
  "name": "@ruvector/attention",
  "version": "2.3.1",
  "description": "Attention mechanisms for transformer models in Node.js: optimal transport, mixed curvature, topology, information geometry and diffusion variants, built in Rust.",
  "homepage": "https://ruv.io",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "attention",
    "binaryName": "attention",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/*.test.js",
    "universal": "napi universal",
    "version": "napi version"
  },
  "repository": {
    "directory": "crates/ruvector-attention-node",
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvector.git"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruvector/issues"
  },
  "author": "rUv <ruv@ruv.io>",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "attention",
    "transformer",
    "machine-learning",
    "napi",
    "rust",
    "ruvector",
    "ruvnet",
    "vector-database",
    "vector-search",
    "hnsw",
    "embeddings",
    "rag",
    "semantic-search",
    "knowledge-graph",
    "gnn",
    "graph-embeddings"
  ],
  "engines": {
    "node": ">= 10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "optionalDependencies": {
    "@ruvector/attention-win32-x64-msvc": "2.3.0",
    "@ruvector/attention-darwin-x64": "2.3.0",
    "@ruvector/attention-darwin-arm64": "2.3.0",
    "@ruvector/attention-linux-x64-gnu": "2.3.0",
    "@ruvector/attention-linux-arm64-gnu": "2.3.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
