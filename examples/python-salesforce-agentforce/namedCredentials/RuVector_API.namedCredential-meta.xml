<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>RuVector API</label>
    <!-- Replace with the real externally-reachable host for your
         `ruvector serve --http` deployment. -->
    <url>https://REPLACE-WITH-YOUR-RUVECTOR-HOST</url>
    <!-- Bearer-token auth: the External Service's generated HTTP calls carry
         this as the Authorization header value, matching
         RUVECTOR_SALESFORCE_ACTION_TOKEN on the ruvector side. Configure the
         actual secret value through Setup, not in this file. -->
    <authentication>
        <authProtocol>Custom</authProtocol>
    </authentication>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <allowMergeFieldsInHttpHeader>false</allowMergeFieldsInHttpHeader>
    <allowMergeFieldsInHttpBody>false</allowMergeFieldsInHttpBody>
</NamedCredential>
